        "financial",
        "personal_data"
      ],
      "side_effects": [
        "spend"
      ],
      "required_permissions": [
        "refunds.create",
        "refunds.read"
      ]
    },
    {
      "skill_id": "customer-correspondence",
      "purpose": "Send a reply to the customer directly, rather than drafting it into the ticket for a person to send.",
